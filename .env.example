# Copy to .env and fill in PRIVATELY:  cp .env.example .env && chmod 600 .env   Never commit .env.
# Compose passes each secret only to the services that need it (see compose.yaml).

# --- Model access: ChatGPT/Codex subscription sign-in inside OpenClaw (no model API keys) -----------
# There is nothing to put here for the sign-in: run the device-code login once per agent (README §5).
# Model of both agents, used as openai/<id>. Must be listed by `models list --provider openai`.
OPENAI_CODEX_MODEL=gpt-5.6-luna
# Optional: a different model for the Researcher agent (empty = OPENAI_CODEX_MODEL).
OPENAI_CODEX_RESEARCHER_MODEL=
# Thinking level of the OpenClaw agents (off | low | medium | high).
OPENCLAW_THINKING=low

# --- OpenClaw Gateway (internal Compose network only) -----------------------------------------------
# Gateway operator token, at least 24 characters. Generate: openssl rand -hex 32
#                                                                    -> services: openclaw, app, researcher
OPENCLAW_GATEWAY_TOKEN=

# --- Telegram ----------------------------------------------------------------------------------------
# Token from @BotFather (/newbot).                                                    -> service: app only
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (e.g. from @userinfobot). The bot serves ONLY this user. -> app only
ALLOWED_TELEGRAM_USER_ID=

# --- Digest defaults (used until the user saves their own settings) --------------------------------
# DEFAULT_LANGUAGE is the language of generated digests; fixed bot/system text is always English.
DEFAULT_LANGUAGE=en
DEFAULT_MAX_ITEMS=5
DEFAULT_PERIOD_HOURS=72

# --- Limits ----------------------------------------------------------------------------------------
# Researcher per A2A task: Gateway calls, tool calls, RSS entries passed to the model.
AGENT_MAX_ITERATIONS=4
AGENT_MAX_TOOL_CALLS=8
RSS_MAX_TOTAL_ENTRIES=30
A2A_TIMEOUT_SECONDS=300
A2A_MAX_ATTEMPTS=2
