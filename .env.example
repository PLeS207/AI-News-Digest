# Copy to .env and fill in PRIVATELY (cp .env.example .env && chmod 600 .env). Never commit .env.
# Compose passes each secret only to the services that need it (see compose.yaml).

# --- Anthropic (Claude API): used by the OpenClaw Coordinator and by the Researcher ------------------
# API key from https://console.anthropic.com/ (Settings -> API keys). -> services: openclaw, researcher
ANTHROPIC_API_KEY=
# Model for both agents. OpenClaw uses it as anthropic/<ANTHROPIC_MODEL>.
# Default claude-opus-5-5; cheaper/faster: claude-sonnet-5-5 or claude-haiku-5-5.
ANTHROPIC_MODEL=claude-opus-5-5
# Researcher reasoning effort (low | medium | high) and OpenClaw editor thinking level (off | low | medium | high)
ANTHROPIC_EFFORT=low
OPENCLAW_THINKING=low
# Researcher only: server-side refusal fallback (beta) for models that support it.
ANTHROPIC_REFUSAL_FALLBACK=true

# --- OpenClaw Gateway (internal Compose network only) -----------------------------------------------
# Shared secret between app and the Gateway. Generate: openssl rand -hex 32   -> services: openclaw, app
OPENCLAW_GATEWAY_TOKEN=

# --- Telegram ----------------------------------------------------------------------------------------
# Token from @BotFather (/newbot).                                            -> service: app only
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (e.g. from @userinfobot). The bot serves ONLY this user.
ALLOWED_TELEGRAM_USER_ID=

# --- Digest defaults (used until the user saves their own settings) --------------------------------
DEFAULT_LANGUAGE=ru
DEFAULT_MAX_ITEMS=5
DEFAULT_PERIOD_HOURS=72

# --- Limits ----------------------------------------------------------------------------------------
AGENT_MAX_ITERATIONS=4
AGENT_MAX_TOOL_CALLS=8
RSS_MAX_TOTAL_ENTRIES=30
A2A_TIMEOUT_SECONDS=300
A2A_MAX_ATTEMPTS=2
