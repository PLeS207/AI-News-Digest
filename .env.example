# Copy to .env and fill in PRIVATELY (cp .env.example .env). Never commit .env.

# --- Anthropic (Claude API) -----------------------------------------------------------
# API key from https://console.anthropic.com/ (Settings -> API keys).
ANTHROPIC_API_KEY=
# Model for BOTH agents. Default: claude-opus-5-5. Cheaper/faster: claude-sonnet-5-5 or claude-haiku-5-5.
ANTHROPIC_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high
ANTHROPIC_EFFORT=low
# Server-side refusal fallback (beta) for models that support it; set false to disable.
ANTHROPIC_REFUSAL_FALLBACK=true

# --- Telegram -----------------------------------------------------------------------
# Token from @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (e.g. from @userinfobot). The bot serves ONLY this user.
ALLOWED_TELEGRAM_USER_ID=

# --- Digest defaults (used until the user saves their own settings) ---------------------
DEFAULT_LANGUAGE=ru
DEFAULT_MAX_ITEMS=5
DEFAULT_PERIOD_HOURS=72

# --- Limits ------------------------------------------------------------------------------
AGENT_MAX_ITERATIONS=4
AGENT_MAX_TOOL_CALLS=8
RSS_MAX_TOTAL_ENTRIES=30
A2A_TIMEOUT_SECONDS=300
A2A_MAX_ATTEMPTS=2
