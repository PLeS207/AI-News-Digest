{
  "id": "digest-telemetry",
  "name": "AI News Digest telemetry",
  "description": "Writes OpenClaw runtime hook events (model calls, tools, runs) to a JSONL trace file and blocks tools outside each agent's allowlist.",
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "traceFile": { "type": "string" },
      "allowedToolsByAgent": {
        "type": "object",
        "additionalProperties": { "type": "array", "items": { "type": "string" } }
      },
      "workspaceMarkers": { "type": "object", "additionalProperties": { "type": "string" } }
    },
    "required": ["traceFile", "allowedToolsByAgent"]
  }
}
